## Coding Standards

### Python Best Practices

#### 1. Code Style
- Follow **PEP 8** style guide
- Use **Black** for automatic formatting (line length: 100)
- Use **type hints** for all functions and variables
- Use **docstrings** for all public functions, classes, and modules

```python
# Good
from typing import List, Optional
from datetime import datetime

async def get_properties(
    *,
    skip: int = 0,
    limit: int = 100,
    city: Optional[str] = None,
    db: Session
) -> List[Property]:
    """
    Retrieve properties with optional filtering.
    
    Args:
        skip: Number of records to skip
        limit: Maximum number of records to return
        city: Optional city filter
        db: Database session
        
    Returns:
        List of Property objects
    """
    query = db.query(Property)
    if city:
        query = query.filter(Property.city == city)
    return query.offset(skip).limit(limit).all()

# Bad
def get_properties(skip, limit, city, db):
    query = db.query(Property)
    if city:
        query = query.filter(Property.city == city)
    return query.offset(skip).limit(limit).all()
```

#### 2. Async/Await
- Use **async def** for all I/O-bound operations
- Use **await** for async calls (database, external APIs, file I/O)
- Use **asyncio.gather()** for concurrent operations

```python
# Good - Async for I/O operations
async def fetch_properties_from_sources():
    zameen_task = fetch_zameen_properties()
    graana_task = fetch_graana_properties()
    
    zameen_data, graana_data = await asyncio.gather(
        zameen_task,
        graana_task
    )
    return zameen_data + graana_data

# Bad - Synchronous blocking
def fetch_properties_from_sources():
    zameen_data = fetch_zameen_properties()
    graana_data = fetch_graana_properties()
    return zameen_data + graana_data
```

#### 3. Error Handling
- Use **try-except** blocks for error-prone operations
- Raise **HTTPException** with proper status codes
- Log all errors with context
- Return meaningful error messages

```python
from fastapi import HTTPException, status
import logging

logger = logging.getLogger(__name__)

async def get_property_by_id(property_id: str, db: Session) -> Property:
    try:
        property = db.query(Property).filter(Property.id == property_id).first()
        
        if not property:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Property with id {property_id} not found"
            )
        
        return property
        
    except HTTPException:
        raise  # Re-raise HTTP exceptions
    except Exception as e:
        logger.error(f"Error fetching property {property_id}: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="An error occurred while fetching the property"
        )
```

### FastAPI Patterns

#### 1. Route Structure
```python
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from typing import List

from app.api import deps
from app.schemas.property import Property, PropertyCreate
from app.services import property_service

router = APIRouter()

@router.get("/", response_model=List[Property])
async def get_properties(
    skip: int = 0,
    limit: int = 100,
    current_user: User = Depends(deps.get_current_user),
    db: Session = Depends(deps.get_db),
) -> List[Property]:
    """
    Retrieve properties with pagination.
    """
    return await property_service.get_properties(
        db=db,
        skip=skip,
        limit=limit
    )

@router.post("/", response_model=Property, status_code=status.HTTP_201_CREATED)
async def create_property(
    *,
    property_in: PropertyCreate,
    current_user: User = Depends(deps.get_current_active_admin),
    db: Session = Depends(deps.get_db),
) -> Property:
    """
    Create new property (Admin only).
    """
    return await property_service.create_property(
        db=db,
        property_in=property_in
    )
```

#### 2. Dependency Injection
```python
# app/api/deps.py
from typing import Generator
from fastapi import Depends, HTTPException, status
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from jose import jwt, JWTError
from sqlalchemy.orm import Session

from app.core.config import settings
from app.core.database import SessionLocal
from app.models.user import User

security = HTTPBearer()

def get_db() -> Generator:
    """Database session dependency."""
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

async def get_current_user(
    credentials: HTTPAuthorizationCredentials = Depends(security),
    db: Session = Depends(get_db)
) -> User:
    """Get current authenticated user."""
    try:
        token = credentials.credentials
        payload = jwt.decode(
            token,
            settings.SECRET_KEY,
            algorithms=[settings.ALGORITHM]
        )
        user_id: str = payload.get("sub")
        
        if user_id is None:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Could not validate credentials"
            )
            
    except JWTError:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Could not validate credentials"
        )
    
    user = db.query(User).filter(User.id == user_id).first()
    
    if not user:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="User not found"
        )
    
    return user

def get_current_active_admin(
    current_user: User = Depends(get_current_user)
) -> User:
    """Require admin role."""
    if not current_user.is_admin:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Not enough permissions"
        )
    return current_user
```

### Pydantic Schemas

#### 1. Request/Response Models
```python
from pydantic import BaseModel, Field, validator
from typing import Optional, List
from datetime import datetime
from enum import Enum

class PropertyType(str, Enum):
    HOUSE = "house"
    APARTMENT = "apartment"
    PLOT = "plot"
    COMMERCIAL = "commercial"

class PropertyBase(BaseModel):
    title: str = Field(..., min_length=5, max_length=200)
    location: str
    city: str
    price: float = Field(..., gt=0)
    property_type: PropertyType
    size: float = Field(..., gt=0)
    beds: Optional[int] = Field(None, ge=0, le=20)
    baths: Optional[int] = Field(None, ge=0, le=20)
    
    @validator("city")
    def validate_city(cls, v):
        allowed_cities = ["Lahore", "Karachi", "Islamabad", "Rawalpindi", "Faisalabad"]
        if v not in allowed_cities:
            raise ValueError(f"City must be one of {allowed_cities}")
        return v

class PropertyCreate(PropertyBase):
    """Schema for creating a property."""
    pass

class PropertyUpdate(PropertyBase):
    """Schema for updating a property (all fields optional)."""
    title: Optional[str] = None
    location: Optional[str] = None
    city: Optional[str] = None
    price: Optional[float] = None
    property_type: Optional[PropertyType] = None
    size: Optional[float] = None

class Property(PropertyBase):
    """Schema for property response."""
    id: str
    created_at: datetime
    updated_at: datetime
    
    class Config:
        from_attributes = True  # SQLAlchemy 2.0
```

### SQLAlchemy Models

```python
from sqlalchemy import Column, String, Float, Integer, DateTime, Enum as SQLEnum, ForeignKey
from sqlalchemy.orm import relationship
from sqlalchemy.dialects.postgresql import UUID
from datetime import datetime
import uuid

from app.core.database import Base

class Property(Base):
    __tablename__ = "properties"
    
    id = Column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    source = Column(String, nullable=False)  # zameen, graana, booking
    source_id = Column(String, nullable=False, unique=True)
    title = Column(String(200), nullable=False, index=True)
    location = Column(String, nullable=False)
    city = Column(String, nullable=False, index=True)
    price = Column(Float, nullable=False, index=True)
    property_type = Column(String, nullable=False, index=True)
    size = Column(Float, nullable=False)
    beds = Column(Integer, nullable=True)
    baths = Column(Integer, nullable=True)
    
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
    updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)
    
    # Relationships
    saved_by = relationship("SavedProperty", back_populates="property")
    
    def __repr__(self):
        return f"<Property {self.title} in {self.city}>"
```

### Service Layer Pattern

```python
# app/services/property_service.py
from typing import List, Optional
from sqlalchemy.orm import Session
from sqlalchemy import or_

from app.models.property import Property
from app.schemas.property import PropertyCreate, PropertyUpdate

class PropertyService:
    
    @staticmethod
    async def get_properties(
        db: Session,
        *,
        skip: int = 0,
        limit: int = 100,
        city: Optional[str] = None,
        min_price: Optional[float] = None,
        max_price: Optional[float] = None,
    ) -> List[Property]:
        """Get properties with filters."""
        query = db.query(Property)
        
        if city:
            query = query.filter(Property.city == city)
        if min_price:
            query = query.filter(Property.price >= min_price)
        if max_price:
            query = query.filter(Property.price <= max_price)
        
        return query.offset(skip).limit(limit).all()
    
    @staticmethod
    async def get_property_by_id(
        db: Session,
        property_id: str
    ) -> Optional[Property]:
        """Get property by ID."""
        return db.query(Property).filter(Property.id == property_id).first()
    
    @staticmethod
    async def create_property(
        db: Session,
        property_in: PropertyCreate
    ) -> Property:
        """Create new property."""
        db_property = Property(**property_in.dict())
        db.add(db_property)
        db.commit()
        db.refresh(db_property)
        return db_property
    
    @staticmethod
    async def search_properties(
        db: Session,
        query: str,
        limit: int = 20
    ) -> List[Property]:
        """Full-text search on properties."""
        return db.query(Property).filter(
            or_(
                Property.title.ilike(f"%{query}%"),
                Property.location.ilike(f"%{query}%")
            )
        ).limit(limit).all()

# Use as singleton
property_service = PropertyService()
```

